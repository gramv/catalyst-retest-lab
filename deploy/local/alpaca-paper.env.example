# Your own Alpaca PAPER account for the local stack's opt-in managed engine (compose profile
# "alpaca-paper"). PAPER TRADING ONLY.
#
#   cp deploy/local/alpaca-paper.env.example .env.paper
#   chmod 600 .env.paper            # then fill in the two values below
#   docker compose --profile alpaca-paper up
#
# .env.paper is ignored by git (.gitignore: .env.*) and by the image build; never commit it.
# Only a paper key works: the engine refuses an id that does not look like a paper key (PK...)
# and the broker endpoints are fixed in code. Every order still needs the exact one-use risk
# authorization. Generate a paper key in the Alpaca dashboard (Paper Trading > API Keys).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional engine overrides (docs/CONFIGURATION.md); the defaults are
# deploy/local/managed-defaults.json (NO_AI_MODE_V1). For example, once you have promoted a
# strategy on this ledger (docs/FIRST-STRATEGY.md, step 7):
# MANAGED_STRATEGIES_JSON=["MY_FIRST_V1"]
