FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home dashboard
USER dashboard
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
# REPORTING_DATABASE_URL must use catalyst_reporting, never the app/risk/database owner role.
# Do not supply any broker credentials to this container.
CMD ["catalyst-lab", "dashboard", "--host", "0.0.0.0", "--port", "8080"]
